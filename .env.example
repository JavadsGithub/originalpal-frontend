# ---------------------------------------------------------------------------
# Original Pal frontend environment
# Copy to `.env.local` (Next.js) or `.env` (tooling) and adjust.
# ---------------------------------------------------------------------------

# --- Browser-facing API base URL ---------------------------------------------------------
# Leave EMPTY for the recommended setup: the browser calls this app's own origin (/api/*) and
# the Next.js server proxies those calls to API_PROXY_TARGET below. No CORS configuration is
# needed on the backend, and the backend's HttpOnly refresh_token cookie stays first-party.
NEXT_PUBLIC_API_URL=

# Alternative: talk to the backend directly from the browser. Only use it when the backend is
# reachable from the browser AND its CORS allowlist includes this app's origin.
# NEXT_PUBLIC_API_URL=http://localhost:8004/api

# --- Server-side proxy target (never exposed to the browser) -----------------------------
# Where the FastAPI backend actually listens. The backend's default port is 8000 (make dev) or
# 8004 (`python -m app.main`); this template's examples use 8004.
API_PROXY_TARGET=http://127.0.0.1:8004

# --- OpenAPI code generation (`pnpm api:generate`) ---------------------------------------
OPENAPI_JSON_URL=http://127.0.0.1:8004/openapi.json

# --- Dev server origins (optional) ------------------------------------------------------
# Extra origins allowed to load internal `next dev` resources, comma separated.
# The sandbox Preview host (*.e2b.app) is allowed by default.
# DEV_ALLOWED_ORIGINS=https://3000-my-sandbox.e2b.app
